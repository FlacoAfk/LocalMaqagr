# Local development defaults only. Never put production credentials in this file.
PORT=4000
NODE_ENV=development

# Local PostgreSQL development instance
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=maqagr_local
DB_USER=postgres
DB_PASS=change-me
DB_SSL=false

# Redis (disabled locally)
REDIS_ENABLED=false

# Development-only placeholder. Production must use a persistent random secret.
JWT_SECRET=replace-this-development-only-secret
JWT_EXPIRES_IN=24h

# Use local disk storage for development; configure a secret manager for cloud storage.
STORAGE_TYPE=local
